{
  "name": "insist-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DISI_INSIST · Windows 客户端",
  "main": "main.js",
  "scripts": {
    "copy:web": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').cpSync('../../insist_app/dist','dist',{recursive:true})\"",
    "start": "npm run copy:web && electron .",
    "package": "npm run copy:web && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.disi.insist",
    "productName": "DISI_INSIST",
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.ico",
      "dist/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DISI_INSIST"
    }
  }
}
